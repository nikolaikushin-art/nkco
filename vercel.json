{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "CI=false DISABLE_ESLINT_PLUGIN=true npm run build",
  "outputDirectory": "build",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/perspectives/:path*",
      "destination": "/privileges/:path*",
      "permanent": true
    },
    {
      "source": "/overview/our-practices/management-services/:path*",
      "destination": "/overview/our-practices/enterprise-management/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}